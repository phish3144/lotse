{
  "name": "@lotse/sync-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lotse sync service (Cloudflare Worker + D1 + R2). Stores ciphertext and metadata only, per SYNC_PROTOCOL.md.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate:local": "wrangler d1 migrations apply lotse --local",
    "migrate:remote": "wrangler d1 migrations apply lotse --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "^5.20260906.1",
    "typescript": "^7.0.2",
    "vitest": "4.1.11",
    "wrangler": "^4.129.0"
  }
}
