    "@tsconfig/svelte": "^5.0.4",
    "happy-dom": "^20.14.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
